#Δεδομένα Παραδείγματος

grades.math = c(72,48,61,47,44,34);  n1 = length(grades.math);
grades.prob = c(70,53,49,60,83);  n2 = length(grades.prob);
grades.stat = c(78,50,61,87,74);  n3 = length(grades.stat);
grades = c(grades.math,grades.prob,grades.stat);
n = c(n1,n2,n3);  k = length(n);  N = sum(n);

#Υπολογισμός SST,SSB,SSW
SST = sum((grades-mean(grades))^2);
SSB = n[1]*sum(mean(grades.stat)-mean(grades))+
      n[2]*sum(mean(grades.prob)-mean(grades))+
      n[3]*sum(mean(grades.stat)-mean(grades)); SSB;
SSW = SST-SSB;  SSW;
SS = c(SST,SSB,SSW); SS;
Fstat = (SSB/(k-1))/(SSW/(N-k)); Fstat;

